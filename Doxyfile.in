PROJECT_NAME           = "PPOIS Laboratory 1"
PROJECT_NUMBER         = @PROJECT_VERSION@
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/docs"
INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/lab1/rubiks_cube/include" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/lab1/rubiks_cube/src" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/lab1/post_machine/include" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/lab1/post_machine/src" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/lab1/README.md"
USE_MDFILE_AS_MAINPAGE  = "@CMAKE_CURRENT_SOURCE_DIR@/lab1/README.md"
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.cpp *.md
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = YES
OUTPUT_LANGUAGE        = English
FULL_PATH_NAMES        = NO
